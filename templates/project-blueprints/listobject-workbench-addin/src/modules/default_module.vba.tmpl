Option Explicit

' ============================================================
' listobject-workbench-addin 蓝图骨架
' 定位：展示"导入 -> 标准化 -> ListObject 输出 -> 汇总刷新"的链路骨架。
' 完整业务实现（约 650 行）见 examples/listobject-workbench-full-reference/，
' 需要完整逻辑时复制该文件内容并按需裁剪，替换占位符。
'
' xlwings 说明：
' - 本骨架同时演示两种 VBA 形态：
'   1. 纯 VBA 链路（__FIRST_CALLBACK_NAME__ / __SECOND_CALLBACK_NAME__ 骨架）
'   2. RunPython 桥接（RunPythonAction 示例）：VBA -> Python 业务逻辑
' - Python 侧代码写入 quickstart 生成的同名 .py 文件中。
' ============================================================

Private Const SOURCE_SHEET_NAME As String = "导入源数据"
Private Const IMPORT_SHEET_NAME As String = "导入结果"
Private Const SUMMARY_SHEET_NAME As String = "客户汇总"
Private Const IMPORT_TABLE_NAME As String = "tblImportedData"
Private Const SUMMARY_TABLE_NAME As String = "tblCustomerSummary"

' ------------------------------------------------------------
' Ribbon 回调（分发器，只做分发，不堆业务逻辑）
' ------------------------------------------------------------

Public Sub __FIRST_CALLBACK_NAME__(ByVal control As IRibbonControl)
    ImportAndNormalizeCurrentWorkbook
End Sub

Public Sub __SECOND_CALLBACK_NAME__(ByVal control As IRibbonControl)
    RefreshSummaryTable
End Sub

' RunPython 桥接示例：通过 Python 处理当前选中区域
Public Sub RunPythonAction(ByVal control As IRibbonControl)
    RunPython "import __PROJECT_NAME__; __PROJECT_NAME__.python_action()"
End Sub

' ------------------------------------------------------------
' 纯 VBA 链路骨架（完整实现见 examples/listobject-workbench-full-reference/）
' ------------------------------------------------------------

Public Sub ImportAndNormalizeCurrentWorkbook()
    ImportAndNormalizeCurrentWorkbookCore True, True
End Sub

Public Sub SmokeImportAndNormalizeCurrentWorkbook()
    ImportAndNormalizeCurrentWorkbookCore False, False
End Sub

Private Sub ImportAndNormalizeCurrentWorkbookCore(ByVal showMessage As Boolean, ByVal allowFilePicker As Boolean)
    Dim targetWb As Workbook
    Dim sourceWb As Workbook
    Dim sourceWs As Worksheet
    Dim outputWs As Worksheet
    Dim outputTable As ListObject
    Dim headerArr As Variant
    Dim dataArr As Variant
    Dim normalizedArr As Variant
    Dim prevScreenUpdating As Boolean
    Dim prevEnableEvents As Boolean
    Dim prevDisplayAlerts As Boolean
    Dim prevCalculation As XlCalculation

    On Error GoTo CleanFail

    Set targetWb = GetTargetWorkbook()
    If targetWb Is Nothing Then
        If showMessage Then MsgBox "当前没有可处理的工作簿。", vbExclamation, "__PROJECT_NAME__"
        Exit Sub
    End If

    Set sourceWs = ResolveSourceWorksheet(targetWb, sourceWb, allowFilePicker)
    If sourceWs Is Nothing Then
        If showMessage Then MsgBox "未找到可导入的源数据工作表。", vbExclamation, "__PROJECT_NAME__"
        GoTo CleanExit
    End If

    prevScreenUpdating = Application.ScreenUpdating
    prevEnableEvents = Application.EnableEvents
    prevDisplayAlerts = Application.DisplayAlerts
    prevCalculation = Application.Calculation

    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.DisplayAlerts = False
    Application.Calculation = xlCalculationManual
    Application.StatusBar = "正在导入并规范化数据，请稍候..."

    ' 完整实现步骤（本文件仅保留调用点，函数体见 examples 参考实现）：
    ' 1. ReadWorksheetTableFromCurrentRegion sourceWs, headerArr, dataArr
    ' 2. normalizedArr = NormalizeImportedData(headerArr, dataArr)
    ' 3. Set outputWs = CreateOrClearWorksheet(targetWb, IMPORT_SHEET_NAME)
    ' 4. Set outputTable = WriteImportedResultTable(outputWs, headerArr, normalizedArr)
    If showMessage Then MsgBox "已生成导入结果表。", vbInformation, "__PROJECT_NAME__"

CleanExit:
    Application.StatusBar = False
    Application.ScreenUpdating = prevScreenUpdating
    Application.EnableEvents = prevEnableEvents
    Application.DisplayAlerts = prevDisplayAlerts
    Application.Calculation = prevCalculation
    CloseWorkbookQuietly sourceWb
    Set outputTable = Nothing
    Set outputWs = Nothing
    Set sourceWs = Nothing
    Set targetWb = Nothing
    Exit Sub

CleanFail:
    If showMessage Then
        MsgBox "导入并规范化失败：" & Err.Description, vbExclamation, "__PROJECT_NAME__"
        Resume CleanExit
    Else
        Application.StatusBar = False
        Application.ScreenUpdating = prevScreenUpdating
        Application.EnableEvents = prevEnableEvents
        Application.DisplayAlerts = prevDisplayAlerts
        Application.Calculation = prevCalculation
        CloseWorkbookQuietly sourceWb
        Err.Raise Err.Number, "ImportAndNormalizeCurrentWorkbookCore", Err.Description
    End If
End Sub

Public Sub RefreshSummaryTable()
    RefreshSummaryTableCore True
End Sub

Public Sub SmokeRefreshSummaryTable()
    RefreshSummaryTableCore False
End Sub

