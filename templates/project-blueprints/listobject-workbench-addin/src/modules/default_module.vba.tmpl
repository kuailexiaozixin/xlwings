' ------------------------------------------------------------
' 基础辅助（骨架保留，完整集合见 examples 参考实现）
' ------------------------------------------------------------

Private Function GetTargetWorkbook() As Workbook
    Dim wb As Workbook

    On Error Resume Next
    If Not ActiveWorkbook Is Nothing Then
        If Not ActiveWorkbook.IsAddin Then
            Set GetTargetWorkbook = ActiveWorkbook
            Exit Function
        End If
    End If

    For Each wb In Application.Workbooks
        If Not wb Is Nothing Then
            If Not wb.IsAddin Then
                Set GetTargetWorkbook = wb
                Exit Function
            End If
        End If
    Next wb
    On Error GoTo 0
End Function

Private Function ResolveSourceWorksheet(ByVal targetWb As Workbook, ByRef sourceWb As Workbook, ByVal allowFilePicker As Boolean) As Worksheet
    Dim filePath As String

    Set ResolveSourceWorksheet = GetWorksheetByName(targetWb, SOURCE_SHEET_NAME)
    If ResolveSourceWorksheet Is Nothing Then
        Set ResolveSourceWorksheet = GetWorksheetByName(targetWb, "源数据")
    End If

    If ResolveSourceWorksheet Is Nothing And allowFilePicker Then
        filePath = PickExcelFilePath()
        If LenB(filePath) = 0 Then Exit Function

        Set sourceWb = OpenWorkbookReadOnly(filePath)
        If sourceWb Is Nothing Then Exit Function

        Set ResolveSourceWorksheet = sourceWb.Worksheets(1)
    End If
End Function

Private Function GetWorksheetByName(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    On Error Resume Next
    Set GetWorksheetByName = wb.Worksheets(sheetName)
    On Error GoTo 0
End Function

Private Function GetListObjectByName(ByVal ws As Worksheet, ByVal tableName As String) As ListObject
    On Error Resume Next
    Set GetListObjectByName = ws.ListObjects(tableName)
    On Error GoTo 0
End Function

Private Function FindListObjectByName(ByVal wb As Workbook, ByVal tableName As String) As ListObject
    Dim ws As Worksheet

    For Each ws In wb.Worksheets
        Set FindListObjectByName = GetListObjectByName(ws, tableName)
        If Not FindListObjectByName Is Nothing Then Exit Function
    Next ws
End Function

Private Function PickExcelFilePath() As String
    Dim fd As FileDialog

    Set fd = Application.FileDialog(msoFileDialogFilePicker)

    With fd
        .Title = "请选择要导入的 Excel 文件"
        .AllowMultiSelect = False
        .Filters.Clear
        .Filters.Add "Excel 文件", "*.xlsx;*.xlsm;*.xls;*.xlsb"

        If .Show <> -1 Then
            PickExcelFilePath = vbNullString
        Else
            PickExcelFilePath = .SelectedItems(1)
        End If
    End With
End Function

Private Function OpenWorkbookReadOnly(ByVal filePath As String) As Workbook
    If LenB(filePath) = 0 Then Exit Function

    Set OpenWorkbookReadOnly = Workbooks.Open( _
        Filename:=filePath, _
        ReadOnly:=True, _
        UpdateLinks:=False)
End Function

Private Sub CloseWorkbookQuietly(ByRef wb As Workbook)
    If wb Is Nothing Then Exit Sub

    wb.Close SaveChanges:=False
    Set wb = Nothing
End Sub
