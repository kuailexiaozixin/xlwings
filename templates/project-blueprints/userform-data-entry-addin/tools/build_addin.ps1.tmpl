#requires -Version 5.1
[CmdletBinding()]
param(
    [string]$ProjectRoot = '',

    [ValidateSet('xlam', 'xlsm')]
    [string]$OutputKind = '__OUTPUT_KIND__',

    [string]$OutputPath = '',

    # xlwings quickstart 工程目录（遵循 SKILL.md 铁律：新建项目必须先 quickstart）
    [AllowEmptyString()]
    [string]$QuickstartProjectPath = '',

    [AllowEmptyString()]
    [string]$FirstIconPath = '',

    [AllowEmptyString()]
    [string]$SecondIconPath = '',

    [switch]$UseBuiltInIcons,

    [switch]$InstallAfterBuild
)

$ErrorActionPreference = 'Stop'

if ([string]::IsNullOrWhiteSpace($ProjectRoot)) {
    $resolvedProjectRoot = [System.IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..'))
}
else {
    $resolvedProjectRoot = [System.IO.Path]::GetFullPath($ProjectRoot)
}

$builderScript = '__EXCEL_BUILDER_SCRIPT_PATH__'
if (-not (Test-Path -LiteralPath $builderScript -PathType Leaf)) {
    throw "未找到中心构建脚本：$builderScript"
}
$skillRoot = [System.IO.Path]::GetFullPath((Join-Path (Split-Path -Parent $builderScript) '..'))
$defaultFirstIconPath = Join-Path $skillRoot 'assets\first-button-icon.png'

function Resolve-ProjectOptionalPath {
    param(
        [AllowEmptyString()]
        [string]$Path
    )

    if ([string]::IsNullOrWhiteSpace($Path)) {
        return ''
    }

    if ([System.IO.Path]::IsPathRooted($Path)) {
        return [System.IO.Path]::GetFullPath($Path)
    }

    return [System.IO.Path]::GetFullPath((Join-Path $resolvedProjectRoot $Path))
}

$resolvedQuickstartProjectPath = Resolve-ProjectOptionalPath -Path $QuickstartProjectPath

$resolvedOutputPath = if ([string]::IsNullOrWhiteSpace($OutputPath)) {
    Join-Path $resolvedProjectRoot ('dist\__PROJECT_NAME__.' + $OutputKind)
}
else {
    [System.IO.Path]::GetFullPath($OutputPath)
}

$modulePath = Join-Path $resolvedProjectRoot 'src\modules\default_module.vba'
$ribbonPath = Join-Path $resolvedProjectRoot 'ribbon\customUI14.xml'
$projectSourceRoot = Join-Path $resolvedProjectRoot 'src'

if (-not (Test-Path -LiteralPath $modulePath -PathType Leaf)) {
    throw "未找到模块文件：$modulePath"
}

if (-not (Test-Path -LiteralPath $ribbonPath -PathType Leaf)) {
    throw "未找到 Ribbon 文件：$ribbonPath"
}

$effectiveFirstIconPath = ''
$effectiveSecondIconPath = ''

if (-not $UseBuiltInIcons) {
    $effectiveFirstIconPath = Resolve-ProjectOptionalPath -Path $FirstIconPath
    if ([string]::IsNullOrWhiteSpace($effectiveFirstIconPath) -and (Test-Path -LiteralPath $defaultFirstIconPath -PathType Leaf)) {
        $effectiveFirstIconPath = $defaultFirstIconPath
    }

    $effectiveSecondIconPath = Resolve-ProjectOptionalPath -Path $SecondIconPath
}

& $builderScript `
    -OutputKind $OutputKind `
    -OutputPath $resolvedOutputPath `
    -ProjectName '__PROJECT_NAME__' `
    -QuickstartProjectPath $resolvedQuickstartProjectPath `
    -ModuleName '__MODULE_NAME__' `
    -RibbonTabId '__RIBBON_TAB_ID__' `
    -RibbonTabLabel '__RIBBON_TAB_LABEL__' `
    -RibbonGroupId '__RIBBON_GROUP_ID__' `
    -RibbonGroupLabel '__RIBBON_GROUP_LABEL__' `
    -FirstButtonId '__FIRST_BUTTON_ID__' `
    -FirstButtonLabel '__FIRST_BUTTON_LABEL__' `
    -FirstCallbackName '__FIRST_CALLBACK_NAME__' `
    -SecondButtonId '__SECOND_BUTTON_ID__' `
    -SecondButtonLabel '__SECOND_BUTTON_LABEL__' `
    -SecondCallbackName '__SECOND_CALLBACK_NAME__' `
    -FirstIconPath $effectiveFirstIconPath `
    -SecondIconPath $effectiveSecondIconPath `
    -ProjectSourceRoot $projectSourceRoot `
    -ModuleTemplatePath $modulePath `
    -RibbonTemplatePath $ribbonPath `
    -InstallAfterBuild:$InstallAfterBuild
