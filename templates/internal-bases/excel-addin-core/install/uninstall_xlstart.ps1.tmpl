# XLSTART 分发一键卸载脚本
# 用法：右键"使用 PowerShell 运行"
# 功能：从 XLSTART 删除 xlam → 清理同名 AddIns 注册 → 输出结果

$ErrorActionPreference = 'Stop'

# ===== 配置区（构建时替换占位符）=====
$AddinFileName = '__ADDIN_FILE_NAME__'       # 如 myproject.xlam
# ======================================

Write-Host "=== XLSTART 分发卸载 ===" -ForegroundColor Cyan

# 1. 获取 XLSTART 路径
try {
    $excel = New-Object -ComObject Excel.Application
    $excel.Visible = $false
    $xlstart = $excel.StartupPath
    Write-Host "[1/3] XLSTART 路径：$xlstart"
} catch {
    throw "无法启动 Excel COM 获取 XLSTART 路径：$_"
}

# 2. 禁用同名 AddIns 注册 + 关闭已打开的同名工作簿
try {
    foreach ($addin in $excel.AddIns) {
        if ($addin.Name -eq $AddinFileName) {
            $addin.Installed = $false
            Write-Host "  已禁用注册：$($addin.Path)"
        }
    }
    foreach ($wb in $excel.Workbooks) {
        if ($wb.Name -eq $AddinFileName) {
            $wb.Close($false)
            Write-Host "  已关闭同名工作簿"
        }
    }
} catch {
    Write-Host "  清理注册时出错（非致命）：$_" -ForegroundColor Yellow
}
Write-Host "[2/3] 注册已清理"

# 3. 从 XLSTART 删除 xlam
$AddinPath = Join-Path $xlstart $AddinFileName
if (Test-Path -LiteralPath $AddinPath -PathType Leaf) {
    try {
        Remove-Item -LiteralPath $AddinPath -Force
        Write-Host "[3/3] 已从 XLSTART 删除：$AddinPath"
    } catch {
        $excel.Quit()
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
        throw "删除失败（文件可能被占用，请关闭 Excel 后重试）：$_"
    }
} else {
    Write-Host "[3/3] XLSTART 中无此加载项（可能已卸载）"
}

# 清理 COM 对象
$excel.Quit()
[System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
[System.GC]::Collect()
[System.GC]::WaitForPendingFinalizers()

Write-Host ""
Write-Host "=== 卸载完成 ===" -ForegroundColor Green
Write-Host "请重启 Excel 以确认加载项已移除"
Write-Host "按任意键退出..."
$null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
