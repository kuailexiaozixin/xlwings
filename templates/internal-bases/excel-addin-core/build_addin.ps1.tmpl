#requires -Version 5.1
[CmdletBinding()]
param(
    [ValidateSet('xlam', 'xlsm')]
    [string]$OutputKind = '__OUTPUT_KIND__',

    # xlwings quickstart 工程目录（遵循 SKILL.md 铁律：新建项目必须先 quickstart）
    [AllowEmptyString()]
    [string]$QuickstartProjectPath = '',

    [switch]$InstallAfterBuild
)

$toolScript = Join-Path $PSScriptRoot 'tools\build_addin.ps1'
if (-not (Test-Path -LiteralPath $toolScript -PathType Leaf)) {
    throw '未找到 tools\build_addin.ps1'
}

& $toolScript `
    -ProjectRoot $PSScriptRoot `
    -OutputKind $OutputKind `
    -QuickstartProjectPath $QuickstartProjectPath `
    -InstallAfterBuild:$InstallAfterBuild
