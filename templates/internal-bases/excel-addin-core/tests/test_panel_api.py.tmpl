"""面板 API 集成测试模板

独立启动 src/server.py，用 requests 调用面板 HTTP 接口，
验证返回值结构与业务正确性。不依赖 Excel，可快速反馈。

用法：
    pytest tests/test_panel_api.py -v
"""
import os
import sys
import time
import subprocess
import socket
import pytest
import requests

# 项目根目录（tests/ 的上一级）
PROJ_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SERVER_PY = os.path.join(PROJ_ROOT, "src", "server.py")
BASE_URL = "http://127.0.0.1:8765"  # 与 server.py 中端口一致


def _free_port():
    """获取一个空闲端口，避免与开发中的面板冲突"""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


@pytest.fixture(scope="module")
def panel_server():
    """启动面板 server 子进程，测试结束后终止"""
    port = _free_port()
    env = os.environ.copy()
    env["PANEL_PORT"] = str(port)
    proc = subprocess.Popen(
        [sys.executable, SERVER_PY, "--port", str(port)],
        cwd=PROJ_ROOT,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
    )
    # 等待 server 就绪（最多 10 秒）
    base = f"http://127.0.0.1:{port}"
    ready = False
    for _ in range(50):
        try:
            r = requests.get(base + "/", timeout=1)
            if r.status_code == 200:
                ready = True
                break
        except requests.ConnectionError:
            time.sleep(0.2)
    if not ready:
        proc.terminate()
        stdout, stderr = proc.communicate(timeout=5)
        pytest.fail(f"面板 server 启动失败\nstdout: {stdout.decode(errors='replace')}\nstderr: {stderr.decode(errors='replace')}")
    yield base
    proc.terminate()
    try:
        proc.communicate(timeout=5)
    except subprocess.TimeoutExpired:
        proc.kill()


class TestPanelAPI:
    """面板 HTTP 接口测试"""

    def test_health_endpoint(self, panel_server):
        """健康检查接口返回 200"""
        r = requests.get(panel_server + "/", timeout=5)
        assert r.status_code == 200

    def test_query_returns_list(self, panel_server):
        """/api/query 返回列表结构（用 mock 数据，不依赖真实网络）"""
        # 注意：真实项目应 mock 外部 API，此处仅演示结构断言
        payload = {"stock_code": "000001", "start_date": "2026-01-01", "end_date": "2026-09-01"}
        r = requests.post(panel_server + "/api/query", json=payload, timeout=10)
        assert r.status_code == 200
        data = r.json()
        # 断言返回结构（根据实际接口调整）
        assert isinstance(data, list) or "results" in data or "data" in data

    def test_download_requires_params(self, panel_server):
        """/api/download 缺少参数时返回错误"""
        r = requests.post(panel_server + "/api/download", json={}, timeout=5)
        # 缺少参数应返回 400 或包含 error 字段
        assert r.status_code in (400, 200)
        if r.status_code == 200:
            data = r.json()
            assert "error" in data or "path" in data

    def test_fill_requires_workbook(self, panel_server):
        """/api/fill 在无目标工作簿时返回明确错误"""
        payload = {"rows": [{"col1": "test"}], "workbook": "nonexistent.xlsx"}
        r = requests.post(panel_server + "/api/fill", json=payload, timeout=5)
        assert r.status_code in (200, 400, 500)
