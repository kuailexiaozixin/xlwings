# XLSTART 分发一键安装脚本
# 用法：将本脚本与 <项目名>.xlam、<项目名>.py、src/ 放在同一交付文件夹中，右键"使用 PowerShell 运行"
# 功能：WebView2 检测 → 获取 XLSTART → 禁用旧注册 → 复制 xlam → 动态写入 PYTHONPATH → 输出结果

$ErrorActionPreference = 'Stop'

# ===== 配置区（构建时替换占位符）=====
$AddinFileName = '__ADDIN_FILE_NAME__'       # 如 myproject.xlam
$ModuleDirName = '__MODULE_DIR_NAME__'       # Python 模块目录名（如 src）
$ConfigSheetName = '__CONFIG_SHEET_NAME__'   # 配置表名（如 myproject.conf，无下划线前缀）
# ======================================

$ScriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path
$AddinSrc = Join-Path $ScriptDir $AddinFileName

Write-Host "=== XLSTART 分发安装 ===" -ForegroundColor Cyan

# 0. WebView2 Runtime 检测（pywebview 面板必需，缺失时窗口静默打不开）
$webview2Found = $false
$webview2Reg = "HKLM:\SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
if (Test-Path $webview2Reg) {
    $webview2Found = $true
}
$webview2Dirs = @(
    "${env:ProgramFiles(x86)}\Microsoft\EdgeWebView\Application",
    "${env:ProgramFiles}\Microsoft\EdgeWebView\Application"
)
foreach ($d in $webview2Dirs) {
    if (Test-Path $d) { $webview2Found = $true; break }
}
if (-not $webview2Found) {
    Write-Host "[WARN] 未检测到 Microsoft WebView2 Runtime" -ForegroundColor Yellow
    Write-Host "  本加载项的面板功能依赖 WebView2，缺失时面板窗口将无法打开。"
    Write-Host "  请下载安装：https://developer.microsoft.com/microsoft-edge/webview2/"
    Write-Host "  （选择 Evergreen Bootstrapper，运行后自动安装）"
    Write-Host ""
    Write-Host "  按 Y 继续安装（面板功能暂不可用），其他键退出..."
    $key = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
    if ($key.Character -ne 'y' -and $key.Character -ne 'Y') {
        Write-Host "已取消安装"
        exit 1
    }
} else {
    Write-Host "[0/7] WebView2 Runtime 检测通过"
}

# 1. 校验交付完整性（入口模块 + xlam + src 包）
if (-not (Test-Path -LiteralPath $AddinSrc -PathType Leaf)) {
    throw "未找到加载项文件：$AddinSrc"
}
$entryModule = Join-Path $ScriptDir ($AddinFileName -replace '\.xlam$', '.py')
if (-not (Test-Path -LiteralPath $entryModule -PathType Leaf)) {
    Write-Host "[WARN] 未找到入口模块：$entryModule（RunPython 调用将失败）" -ForegroundColor Yellow
}
Write-Host "[1/7] 交付完整性校验通过"

# 2. 获取 XLSTART 路径（通过 COM 自动化，兼容 Excel/WPS）
try {
    $excel = New-Object -ComObject Excel.Application
    $excel.Visible = $false
    $xlstart = $excel.StartupPath
    Write-Host "[2/7] XLSTART 路径：$xlstart"
} catch {
    throw "无法启动 Excel COM 获取 XLSTART 路径：$_"
}

# 3. 安装前清理：枚举 AddIns，禁用同名旧注册（防止旧路径残留与 XLSTART 新副本冲突）
$cleaned = $false
try {
    foreach ($addin in $excel.AddIns) {
        if ($addin.Name -eq $AddinFileName) {
            $addin.Installed = $false
            $cleaned = $true
            Write-Host "  已禁用旧注册：$($addin.Path)"
        }
    }
    # 关闭已打开的同名加载项工作簿
    foreach ($wb in $excel.Workbooks) {
        if ($wb.Name -eq $AddinFileName) {
            $wb.Close($false)
            Write-Host "  已关闭已打开的同名工作簿"
        }
    }
} catch {
    Write-Host "  清理旧注册时出错（非致命）：$_" -ForegroundColor Yellow
}
if ($cleaned) {
    Write-Host "[3/7] 旧注册已清理"
} else {
    Write-Host "[3/7] 无旧注册残留"
}

# 4. 复制 xlam 到 XLSTART（XLSTART 分发不需 AddIns.Add 注册）
$AddinDst = Join-Path $xlstart $AddinFileName
try {
    Copy-Item -LiteralPath $AddinSrc -Destination $AddinDst -Force
    Write-Host "[4/7] 已复制到 XLSTART：$AddinDst"
} catch {
    $excel.Quit()
    [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
    throw "复制到 XLSTART 失败：$_"
}

# 5. 动态写入 PYTHONPATH（指向交付文件夹根目录，入口模块所在目录）
#    构建时配置表只写 Interpreter_Win，PYTHONPATH 由安装脚本动态写入（目标机路径）
try {
    $wb = $excel.Workbooks.Open($AddinDst)
    $sheet = $wb.Sheets.Item($ConfigSheetName)
    # 查找 PYTHONPATH 行（A 列），更新 B 列值
    $lastRow = $sheet.UsedRange.Rows.Count
    $pythonPathFound = $false
    for ($r = 1; $r -le $lastRow; $r++) {
        $key = $sheet.Cells.Item($r, 1).Value2
        if ($key -eq 'PYTHONPATH') {
            $sheet.Cells.Item($r, 2).Value = $ScriptDir
            $pythonPathFound = $true
            Write-Host "  已更新 PYTHONPATH = $ScriptDir"
            break
        }
    }
    if (-not $pythonPathFound) {
        # 追加新行
        $newRow = $lastRow + 1
        $sheet.Cells.Item($newRow, 1).Value = 'PYTHONPATH'
        $sheet.Cells.Item($newRow, 2).Value = $ScriptDir
        Write-Host "  已追加 PYTHONPATH = $ScriptDir"
    }
    $wb.Save()
    $wb.Close($false)
    Write-Host "[5/7] PYTHONPATH 已动态写入（指向交付文件夹根目录）"
} catch {
    Write-Host "[WARN] PYTHONPATH 写入失败：$_（请手动在配置表中设置 PYTHONPATH）" -ForegroundColor Yellow
}

# 6. Ribbon 回注（COM 保存会覆盖 customUI 注册，须重新注入）
try {
    $skillRoot = Split-Path -Parent $ScriptDir  # 交付文件夹上一级（开发机场景）
    $reinjectScript = Join-Path $skillRoot "scripts\tools\reinject_ribbon_after_com_save.py"
    if (Test-Path $reinjectScript) {
        & python $reinjectScript --xlam-path $AddinDst 2>&1 | Out-Null
        Write-Host "[6/7] Ribbon 已回注"
    } else {
        Write-Host "[6/7] Ribbon 回注脚本未找到，跳过（如 Ribbon 丢失请手动回注）"
    }
} catch {
    Write-Host "[WARN] Ribbon 回注失败：$_" -ForegroundColor Yellow
}

# 7. 清理 COM 对象
$excel.Quit()
[System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
[System.GC]::Collect()
[System.GC]::WaitForPendingFinalizers()

Write-Host ""
Write-Host "=== 安装完成 ===" -ForegroundColor Green
Write-Host "加载项：$AddinDst"
Write-Host "PYTHONPATH：$ScriptDir"
Write-Host "请重启 Excel 以自动加载新复制的加载项"
Write-Host "按任意键退出..."
$null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
