Option Explicit

Private mWindowStyleApplied As Boolean
Private Const TARGET_RIGHT_PADDING As Single = 24
Private Const TARGET_BOTTOM_PADDING As Single = 30
Private Const TARGET_MIN_INSIDE_WIDTH As Single = 348
Private Const TARGET_MIN_INSIDE_HEIGHT As Single = 326
Private Const TARGET_LONG_ROW_REQUIRED_WIDTH As Single = 348
Private Const TARGET_MIXED_INFO_ROW_REQUIRED_WIDTH As Single = 348
Private Const TARGET_OPTIONS_ROW_REQUIRED_WIDTH As Single = 348
Private Const TARGET_MAX_FIELD_GROUPS_PER_ROW As Long = 2
Private mActivationTrace As String

Private Sub UserForm_Initialize()
    Me.Caption = "业务数据录入"
    Me.txtCustomerName.Value = "示例客户有限公司"
    Me.txtProjectName.Value = "年度经营分析"
    Me.txtOwnerName.Value = "张三"
    Me.txtAmountValue.Value = "128000"
    Me.cboPriority.Value = "高"
    Me.chkCreateSummary.Value = True
End Sub

Private Sub UserForm_Activate()
    If mWindowStyleApplied Then Exit Sub

    mActivationTrace = ""
    AppendActivationTrace "BeforeApply"
    EnableUserFormResizeAndMaximize Me.Caption
    AppendActivationTrace "AfterEnableResizeStyle"
    AppendActivationTrace "AfterActivate"
    mWindowStyleApplied = True
End Sub

Private Sub btnDiagnostics_Click()
    MsgBox BuildSizeDiagnosticsReport(), vbInformation, "窗体尺寸诊断"
End Sub

Private Sub btnOk_Click()
    Dim amountValue As Double

    If LenB(Trim$(Me.txtCustomerName.Value)) = 0 Then
        MsgBox "客户名称不能为空。", vbExclamation, "__PROJECT_NAME__"
        Me.txtCustomerName.SetFocus
        Exit Sub
    End If

    If LenB(Trim$(Me.txtProjectName.Value)) = 0 Then
        MsgBox "项目名称不能为空。", vbExclamation, "__PROJECT_NAME__"
        Me.txtProjectName.SetFocus
        Exit Sub
    End If

    If Not IsNumeric(Me.txtAmountValue.Value) Then
        MsgBox "金额必须是数值。", vbExclamation, "__PROJECT_NAME__"
        Me.txtAmountValue.SetFocus
        Exit Sub
    End If

    If LenB(Trim$(Me.cboPriority.Value)) = 0 Then
        MsgBox "请选择优先级。", vbExclamation, "__PROJECT_NAME__"
        Me.cboPriority.SetFocus
        Exit Sub
    End If

    amountValue = CDbl(Me.txtAmountValue.Value)
    SaveBusinessRecord _
        Trim$(Me.txtCustomerName.Value), _
        Trim$(Me.txtProjectName.Value), _
        Trim$(Me.txtOwnerName.Value), _
        amountValue, _
        GetSelectedPriorityText(), _
        CBool(Me.chkCreateSummary.Value)

    MsgBox "已写入结果表。", vbInformation, "__PROJECT_NAME__"
    Unload Me
End Sub

Private Sub btnCancel_Click()
    Unload Me
End Sub

Private Function BuildSizeDiagnosticsReport() As String
    Dim reportText As String
    Dim controlObject As Object
    Dim maxRight As Single
    Dim maxBottom As Single
    Dim currentRight As Single
    Dim currentBottom As Single

    reportText = "Caption=" & Me.Caption & vbCrLf
    reportText = reportText & "Me.Width=" & Format$(Me.Width, "0.0") & " pt" & vbCrLf
    reportText = reportText & "Me.Height=" & Format$(Me.Height, "0.0") & " pt" & vbCrLf
    reportText = reportText & "Me.InsideWidth=" & Format$(Me.InsideWidth, "0.0") & " pt" & vbCrLf
    reportText = reportText & "Me.InsideHeight=" & Format$(Me.InsideHeight, "0.0") & " pt" & vbCrLf

    For Each controlObject In Me.Controls
        currentRight = controlObject.Left + controlObject.Width
        currentBottom = controlObject.Top + controlObject.Height
        If currentRight > maxRight Then maxRight = currentRight
        If currentBottom > maxBottom Then maxBottom = currentBottom

        reportText = reportText & controlObject.Name & " [" & TypeName(controlObject) & "] "
        reportText = reportText & "L=" & Format$(controlObject.Left, "0.0")
        reportText = reportText & " T=" & Format$(controlObject.Top, "0.0")
        reportText = reportText & " W=" & Format$(controlObject.Width, "0.0")
        reportText = reportText & " H=" & Format$(controlObject.Height, "0.0") & vbCrLf
    Next controlObject

    reportText = reportText & String$(30, "-") & vbCrLf
    reportText = reportText & "TargetInsideWidth=" & Format$(GetTargetRuntimeInsideWidth(), "0.0") & " pt" & vbCrLf
    reportText = reportText & "TargetInsideHeight=" & Format$(GetTargetRuntimeInsideHeight(), "0.0") & " pt" & vbCrLf
    reportText = reportText & "LayoutMinInsideWidth=" & Format$(GetLayoutMinInsideWidth(), "0.0") & " pt" & vbCrLf
    reportText = reportText & "CurrentMaxFieldGroupsPerRow=" & CStr(TARGET_MAX_FIELD_GROUPS_PER_ROW) & vbCrLf
    reportText = reportText & String$(30, "-") & vbCrLf
    reportText = reportText & mActivationTrace
    reportText = reportText & String$(30, "-") & vbCrLf
    reportText = reportText & "ControlsMaxRight=" & Format$(maxRight, "0.0") & " pt" & vbCrLf
    reportText = reportText & "ControlsMaxBottom=" & Format$(maxBottom, "0.0") & " pt" & vbCrLf
    reportText = reportText & "SuggestedMinInsideWidth=" & Format$(GetTargetRuntimeInsideWidth(), "0.0") & " pt" & vbCrLf
    reportText = reportText & "SuggestedMinInsideHeight=" & Format$(GetTargetRuntimeInsideHeight(), "0.0") & " pt"

    BuildSizeDiagnosticsReport = reportText
End Function

Public Sub ApplyPostShowSizeFromHost()
    AppendActivationTrace "BeforeHostApply"
    ApplyRuntimeTargetSize
    AppendActivationTrace "AfterHostApplyRuntimeTargetSize"
    SetUserFormClientSize Me.Caption, GetTargetRuntimeInsideWidth(), GetTargetRuntimeInsideHeight()
    AppendActivationTrace "AfterHostSetUserFormClientSize"
    DoEvents
    ApplyRuntimeTargetSize
    AppendActivationTrace "AfterHostFinalApplyRuntimeTargetSize"
End Sub

Private Sub ApplyRuntimeTargetSize()
    On Error Resume Next
    Me.Width = GetTargetRuntimeInsideWidth()
    Me.Height = GetTargetRuntimeInsideHeight()
    On Error GoTo 0
End Sub

Private Sub AppendActivationTrace(ByVal stageName As String)
    mActivationTrace = mActivationTrace & stageName _
        & ": Width=" & Format$(Me.Width, "0.0") _
        & ", Height=" & Format$(Me.Height, "0.0") _
        & ", InsideWidth=" & Format$(Me.InsideWidth, "0.0") _
        & ", InsideHeight=" & Format$(Me.InsideHeight, "0.0") _
        & vbCrLf
End Sub

Private Function GetTargetRuntimeInsideWidth() As Single
    Dim boundaryWidth As Single
    Dim layoutMinWidth As Single
    Dim maxRight As Single
    Dim targetBaseWidth As Single

    maxRight = GetTopLevelControlsMaxRight()
    boundaryWidth = maxRight + TARGET_RIGHT_PADDING
    layoutMinWidth = GetLayoutMinInsideWidth()
    targetBaseWidth = TARGET_MIN_INSIDE_WIDTH

    If boundaryWidth > targetBaseWidth Then
        targetBaseWidth = boundaryWidth
    End If
    If layoutMinWidth > targetBaseWidth Then
        targetBaseWidth = layoutMinWidth
    End If

    GetTargetRuntimeInsideWidth = GetRoundedTargetSize(targetBaseWidth)
End Function

Private Function GetTargetRuntimeInsideHeight() As Single
    Dim maxBottom As Single

    maxBottom = GetTopLevelControlsMaxBottom()
    If maxBottom + TARGET_BOTTOM_PADDING > TARGET_MIN_INSIDE_HEIGHT Then
        GetTargetRuntimeInsideHeight = GetRoundedTargetSize(maxBottom + TARGET_BOTTOM_PADDING)
    Else
        GetTargetRuntimeInsideHeight = TARGET_MIN_INSIDE_HEIGHT
    End If
End Function

Private Function GetTopLevelControlsMaxRight() As Single
    Dim controlObject As Object
    Dim currentRight As Single
    Dim maxRight As Single

    For Each controlObject In Me.Controls
        currentRight = controlObject.Left + controlObject.Width
        If currentRight > maxRight Then
            maxRight = currentRight
        End If
    Next controlObject

    GetTopLevelControlsMaxRight = maxRight
End Function

Private Function GetTopLevelControlsMaxBottom() As Single
    Dim controlObject As Object
    Dim currentBottom As Single
    Dim maxBottom As Single

    For Each controlObject In Me.Controls
        currentBottom = controlObject.Top + controlObject.Height
        If currentBottom > maxBottom Then
            maxBottom = currentBottom
        End If
    Next controlObject

    GetTopLevelControlsMaxBottom = maxBottom
End Function

Private Function GetLayoutMinInsideWidth() As Single
    Dim requiredWidth As Single

    requiredWidth = TARGET_MIN_INSIDE_WIDTH
    If TARGET_LONG_ROW_REQUIRED_WIDTH > requiredWidth Then requiredWidth = TARGET_LONG_ROW_REQUIRED_WIDTH
    If TARGET_MIXED_INFO_ROW_REQUIRED_WIDTH > requiredWidth Then requiredWidth = TARGET_MIXED_INFO_ROW_REQUIRED_WIDTH
    If TARGET_OPTIONS_ROW_REQUIRED_WIDTH > requiredWidth Then requiredWidth = TARGET_OPTIONS_ROW_REQUIRED_WIDTH

    GetLayoutMinInsideWidth = GetRoundedTargetSize(requiredWidth)
End Function

Private Function GetRoundedTargetSize(ByVal rawSize As Single) As Single
    GetRoundedTargetSize = CSng((Int((rawSize + 5) / 6) * 6))
End Function

Private Sub UserForm_Terminate()
    ReleaseDataEntryWizardReference
End Sub

Private Function GetSelectedPriorityText() As String
    If LenB(Trim$(Me.cboPriority.Value)) = 0 Then
        GetSelectedPriorityText = "高"
    Else
        GetSelectedPriorityText = Trim$(Me.cboPriority.Value)
    End If
End Function
